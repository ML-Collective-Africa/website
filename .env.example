# Used to sign admin session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# The first super admin. Created on first sign-in if no admins exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Site admin

# Where the content store keeps its JSON files and uploads. Defaults to ./.data
# DATA_DIR=.data
