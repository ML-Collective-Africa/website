# Postgres connection. On Vercel this comes from the Neon integration.
DATABASE_URL=postgres://user:password@host/dbname

# Signs admin sign-ins. Use a long random string in production.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Image storage. On Vercel this comes from the Blob integration.
# Leave it unset locally and uploads are saved to ./media instead.
# BLOB_READ_WRITE_TOKEN=

# The first super admin, created by the build when there are no admins yet.
# They're asked to set their own password on first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Site admin

# Optional: the site's public address, once there's a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.org
